# انسخ هذا الملف إلى .env.local واملأ القيم. لا ترفع .env.local إلى git.

NEXT_PUBLIC_SITE_URL=https://example.com

# #region env-mail
# SMTP لإرسال إيميلات النماذج. بدون SMTP_HOST تُطبع الرسائل في الطرفية ولا تُرسل.
# مثال Microsoft 365: smtp.office365.com والمنفذ 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# وجهة كل نموذج
CONTACT_TO=
HR_TO=
JOBS_SHEET_URL=
# #endregion env-mail

# رقم واتساب بالصيغة الدولية أرقاماً فقط، بلا + ولا أصفار في البداية
WHATSAPP_NUMBER=

# وسم Google (Analytics: G-xxxx، أو Ads: AW-xxxx). بدونه لا يُحمَّل أي سكريبت تتبع.
GTAG_ID=
# الدول التي تكون فيها الموافقة granted افتراضياً، رموز ISO مفصولة بفاصلة (مثل SA,AE).
# القرار للعميل حسب قوانين بلد زواره. باقي الدول denied.
CONSENT_GRANTED_REGIONS=
